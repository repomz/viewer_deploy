COMPOSE_PROJECT_NAME=viewer
TZ=Asia/Tomsk

# Registry images used by the current production stack.
BACKEND_IMAGE=idrisovmarat/viewer_backend:0.2.7
BACKEND_MIGRATIONS_IMAGE=idrisovmarat/viewer_backend-migrations:0.2.0
FRONTEND_IMAGE=idrisovmarat/viewer_frontend:0.2.29

# PostgreSQL. Use URL-safe characters because the password is part of DB_DSN.
POSTGRES_DB=viewer
POSTGRES_USER=viewer
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES

# Public listeners. Administrative HTTP ports are loopback-only by default.
PUBLIC_BIND_ADDRESS=0.0.0.0
ADMIN_BIND_ADDRESS=127.0.0.1
FRONTEND_HTTP_PORT=80
FRONTEND_HTTPS_PORT=443
BACKEND_ADMIN_PORT=8080
ORTHANC_ADMIN_PORT=8042
ORTHANC_DICOM_PORT=4242

# Keep these values synchronized with config/orthanc.json.
ORTHANC_USERNAME=mapdr
ORTHANC_PASSWORD=CHANGE_ME_ORTHANC
PACS_AUTHORIZATION=Basic CHANGE_ME_BASE64_MAPDR_COLON_PASSWORD

# Host directories with fullchain.pem/privkey.pem and ACME webroot.
VIEWER_TLS_DIR=/opt/viewer/tls
CERTBOT_WEBROOT=/opt/viewer/certbot/www

REPORT_AGENT_ID=2
REPORTS_DIR=/app/reports
PLANS_DIR=/app/plans
XA_CACHE_DIR=/app/xa-cache
XA_CACHE_TIMEOUT_SECONDS=120
XA_CACHE_STUDY_WORKERS=1
XA_CACHE_FRAME_WORKERS=1
XA_CACHE_CINE_WORKERS=1
XA_CACHE_CINE_CRF=23
XA_CACHE_BUILD_ARCHIVE=false
XA_CACHE_WARM_EXISTING=false
XA_ARCHIVE_STUDY_WORKERS=1
XA_ARCHIVE_DELETE_PACS=false
XA_ARCHIVE_DELETE_LOCAL=false
STUDY_RETENTION_ENABLED=false

REMOTE_PACS_URL=http://pacs:8042/instances
REMOTE_PACS_USERNAME=mapdr
REMOTE_PACS_PASSWORD=CHANGE_ME_ORTHANC
REMOTE_PACS_TIMEOUT_SECONDS=300
REMOTE_PACS_IMPORT_WORKERS=1

YANDEX_BUCKET=agent-dicom
YANDEX_ENDPOINT=https://storage.yandexcloud.net
YANDEX_REGION=ru-central1
YANDEX_ACCESS_KEY_ID=
YANDEX_SECRET_ACCESS_KEY=

